{
  "name": "tome",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "An ink-on-old-paper mdBook viewer built on sacred-computer components.",
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs && node scripts/load-books.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-fonts.mjs && node scripts/load-books.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "electron": "npm run build && electron electron/main.cjs",
    "electron:start": "electron electron/main.cjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:external": "node scripts/check-external-build.mjs",
    "check:livereload": "node scripts/check-live-reload.mjs",
    "check:multibook": "node scripts/check-multibook.mjs",
    "check:search": "node scripts/check-search.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/solid-js": "^7.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "smol-toml": "^1.8.0",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.3.0",
    "electron": "^43.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "8.2.1"
  }
}
