---
import '../styles/tokens.css';
import InitTheme from '../components/init-theme.astro';
import TocSidebar, { type SwitcherBook } from '../components/TocSidebar';
import SearchOverlay from '../components/SearchOverlay';
import OnThisPage, { type Heading } from '../components/OnThisPage';
import { DEFAULT_THEME } from '../styles/theme';
import type { BookToc } from '../lib/summary.types';

interface Props {
  toc: BookToc;
  activeSlug: string;
  title: string;
  /** Namespace prefix for chapter links; `''` in a single-tome library. */
  bookSlug?: string;
  /** The library's tomes for the sidebar switcher; omitted with a single tome. */
  books?: SwitcherBook[];
  /** The active tome's slug, marked in the switcher. */
  activeBook?: string;
  /** The chapter's H2/H3 headings for the "on this page" rail. */
  headings?: Heading[];
}

const { toc, activeSlug, title, bookSlug = '', books, activeBook, headings = [] } = Astro.props;
const bookTitle = toc.title ?? 'Tome';
const hasRail = headings.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class={DEFAULT_THEME.className}>
    <InitTheme />
    <div class:list={['app', { 'has-rail': hasRail }]}>
      <TocSidebar
        toc={toc}
        activeSlug={activeSlug}
        bookTitle={bookTitle}
        bookSlug={bookSlug}
        books={books}
        activeBook={activeBook}
        client:idle
      />
      <main class="content">
        <div class="searchbar">
          <SearchOverlay libraryWide={(books?.length ?? 0) > 1} client:idle />
        </div>
        <slot />
      </main>
      {
        hasRail && (
          <aside class="rail-col">
            <OnThisPage headings={headings} client:idle />
          </aside>
        )
      }
    </div>
  </body>
</html>

<style>
  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100dvh;
  }

  .content {
    position: relative;
    z-index: var(--z-page);
    padding: var(--space-8) var(--space-6);
    min-width: 0;
  }

  .searchbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-6);
  }

  .rail-col {
    display: none;
  }

  @media (min-width: 48.0625rem) {
    .app {
      grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
    }

    .content {
      padding: var(--space-10) var(--space-8);
    }
  }

  /* Wide viewports gain the "on this page" rail as a third column. */
  @media (min-width: 64rem) {
    .app.has-rail {
      grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr) minmax(11rem, 15rem);
    }

    .rail-col {
      display: block;
      padding: var(--space-10) var(--space-6) var(--space-10) 0;
      min-width: 0;
    }
  }
</style>
