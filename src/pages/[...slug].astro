---
import type { MarkdownInstance } from 'astro';
import BookLayout from '../layouts/BookLayout.astro';
import Pager from '../components/Pager.astro';
import Bibliotheca from '../components/Bibliotheca.astro';
import ReaderKeys from '../components/ReaderKeys';
import { books, tomePages, bibliothecaEntries, isContentKeyFor } from '../lib/book';
import { chapterUrlIn } from '../lib/paths';
import type { Heading } from '../components/OnThisPage';
import { resolveOwner } from '../../scripts/library-config.mjs';

// Every chapter's Markdown, keyed by path. Importers are lazy; each generated
// page loads only its own chapter.
const contentModules = import.meta.glob<MarkdownInstance<Record<string, unknown>>>(
  '../content/books/**/*.md',
);

export function getStaticPaths() {
  // Adaptive: one tome → root routes; many → namespaced routes + a `/` Bibliotheca.
  return tomePages(books()).map((page) => ({
    params: { slug: page.routeSlug === '' ? undefined : page.routeSlug },
    props: page,
  }));
}

const page = Astro.props;
const library = books();
const multi = library.length > 1;
// The switcher only exists with several tomes; drop `count` for the island props.
const switcher = multi
  ? bibliothecaEntries(library).map(({ slug, title, href }) => ({ slug, title, href }))
  : undefined;

let Content: MarkdownInstance<Record<string, unknown>>['Content'] | undefined;
let headings: Heading[] = [];
if (page.kind === 'chapter') {
  const entry = Object.entries(contentModules).find(([key]) =>
    isContentKeyFor(key, page.book.slug, page.route.chapter.href!),
  );
  if (!entry) {
    throw new Error(
      `Tome: no Markdown found for "${page.book.slug}/${page.route.chapter.href}"`,
    );
  }
  const mod = await entry[1]();
  Content = mod.Content;
  // The chapter's section headings (H2/H3) for the "on this page" rail. The GFM
  // footnotes section injects an H2 "Footnotes" (id `footnote-label`) — drop it.
  headings = (mod.getHeadings?.() ?? []).filter(
    (h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label',
  );
}

// Adaptive prev/next chapter URLs for the pager + keyboard navigation.
const navBookSlug = page.kind === 'chapter' && multi ? page.book.slug : '';
const prevUrl =
  page.kind === 'chapter' && page.route.prev
    ? chapterUrlIn(navBookSlug, page.route.prev.href!)
    : undefined;
const nextUrl =
  page.kind === 'chapter' && page.route.next
    ? chapterUrlIn(navBookSlug, page.route.next.href!)
    : undefined;
---

{
  page.kind === 'bibliotheca' ? (
    <Bibliotheca books={page.books} owner={await resolveOwner()} />
  ) : (
    Content && (
      <BookLayout
        toc={page.book.toc}
        activeSlug={page.route.slug}
        bookSlug={multi ? page.book.slug : ''}
        books={switcher}
        activeBook={page.book.slug}
        title={page.route.chapter.title}
        headings={headings}
      >
        <article class="tome-prose">
          <Content />
        </article>
        <Pager prev={page.route.prev} next={page.route.next} bookSlug={navBookSlug} />
        <ReaderKeys prevUrl={prevUrl} nextUrl={nextUrl} client:idle />
      </BookLayout>
    )
  )
}
